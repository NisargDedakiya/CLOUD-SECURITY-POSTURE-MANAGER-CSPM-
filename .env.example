# CSPM environment configuration. Copy to .env and fill in for your environment.

# development | staging | production  (prod enforces the guards below)
CSPM_ENV=development

# Postgres in prod; defaults to in-memory SQLite when unset (dev/tests only).
CSPM_DATABASE_URL=postgresql+psycopg://cspm:cspm@localhost:5432/cspm

# Shared Celery broker.
CSPM_REDIS_URL=redis://localhost:6379/0

# AES-256 field-encryption key (REQUIRED in production).
# Generate: python -c "from cspm.security.crypto import generate_key; print(generate_key())"
CSPM_ENCRYPTION_KEY=

# Run audits inline instead of enqueuing on Celery. Must be false in production.
CSPM_EAGER_TASKS=true

# Observability.
CSPM_LOG_LEVEL=INFO
CSPM_JSON_LOGS=false

# Tuning.
CSPM_AUDIT_CONCURRENCY=8
CSPM_DRIFT_INTERVAL_HOURS=6
CSPM_PAGE_SIZE=50
CSPM_MAX_PAGE_SIZE=200
CSPM_SCAN_MAX_RETRIES=5
CSPM_SCAN_BACKOFF_BASE=1.5
CSPM_RATE_LIMIT_PER_MIN=120

# ---- Auth / SSO ----
# headers (dev) | secret (HS256 JWT) | jwks (OIDC RS256 — Okta/Azure AD)
CSPM_AUTH_MODE=headers
CSPM_JWT_SECRET=
CSPM_OIDC_JWKS_URL=
CSPM_OIDC_ISSUER=
CSPM_OIDC_AUDIENCE=
CSPM_OIDC_ORG_CLAIM=org
CSPM_OIDC_ROLES_CLAIM=roles
# Shared bearer token the IdP uses for SCIM provisioning.
CSPM_SCIM_TOKEN=

# ---- Secrets management ----
# env | aws_kms | vault
CSPM_KEY_PROVIDER=env
CSPM_KMS_KEY_ID=
CSPM_VAULT_ADDR=
CSPM_VAULT_KEY_PATH=

# ---- Retention (data residency / GDPR) ----
CSPM_FINDINGS_RETENTION_DAYS=365
CSPM_AUDIT_RETENTION_DAYS=730

# ---- Observability ----
CSPM_METRICS_ENABLED=true
CSPM_SENTRY_DSN=

# ---- Integrations (alerting) ----
CSPM_ALERT_MIN_SEVERITY=high
CSPM_SLACK_WEBHOOK_URL=
CSPM_WEBHOOK_URL=
CSPM_PAGERDUTY_ROUTING_KEY=

# ---- Billing / subscriptions ----
# manual (set plans directly) | stripe (Checkout + Portal + webhooks)
CSPM_BILLING_MODE=manual
CSPM_STRIPE_SECRET_KEY=
CSPM_STRIPE_WEBHOOK_SECRET=
CSPM_STRIPE_PRICE_STARTER=
CSPM_STRIPE_PRICE_PRO=
CSPM_BILLING_SUCCESS_URL=http://localhost:8000/#/billing?status=success
CSPM_BILLING_CANCEL_URL=http://localhost:8000/#/billing?status=cancel

# ---- Onboarding (one-click AWS role) ----
CSPM_AWS_PLATFORM_ACCOUNT_ID=000000000000
CSPM_ONBOARDING_TEMPLATE_URL=https://your-bucket.s3.amazonaws.com/aegis/aws-role.yaml
CSPM_ONBOARDING_ROLE_NAME=AegisCSPMAuditRole

# ---- Razorpay (INR billing; CSPM_BILLING_MODE=razorpay) ----
CSPM_RAZORPAY_KEY_ID=
CSPM_RAZORPAY_KEY_SECRET=
CSPM_RAZORPAY_WEBHOOK_SECRET=
CSPM_RAZORPAY_PLAN_STARTER=
CSPM_RAZORPAY_PLAN_PRO=
