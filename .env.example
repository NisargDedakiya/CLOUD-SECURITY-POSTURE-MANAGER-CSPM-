# CSPM environment configuration. Copy to .env and fill in for your environment.

# development | staging | production  (prod enforces the guards below)
CSPM_ENV=development

# Postgres in prod; defaults to in-memory SQLite when unset (dev/tests only).
CSPM_DATABASE_URL=postgresql+psycopg://cspm:cspm@localhost:5432/cspm

# Shared Celery broker.
CSPM_REDIS_URL=redis://localhost:6379/0

# AES-256 field-encryption key (REQUIRED in production).
# Generate: python -c "from cspm.security.crypto import generate_key; print(generate_key())"
CSPM_ENCRYPTION_KEY=

# Run audits inline instead of enqueuing on Celery. Must be false in production.
CSPM_EAGER_TASKS=true

# Observability.
CSPM_LOG_LEVEL=INFO
CSPM_JSON_LOGS=false

# Tuning.
CSPM_AUDIT_CONCURRENCY=8
CSPM_DRIFT_INTERVAL_HOURS=6
CSPM_PAGE_SIZE=50
CSPM_MAX_PAGE_SIZE=200
